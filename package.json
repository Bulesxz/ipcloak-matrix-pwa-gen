{
  "name": "pwa-gen",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:cf": "npx @cloudflare/next-on-pages@latest",
    "preview": "wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat",
    "deploy": "./deploy.sh",
    "start": "next start",
    "lint": "next lint",
    "video": "node scripts/video/record.js zh && python3 scripts/video/tts.py zh && bash scripts/video/build.sh zh",
    "video:tts": "python3 scripts/video/tts.py zh",
    "video:tts:edge": "python3 scripts/video/tts.py zh --engine edge-tts --proxy http://127.0.0.1:7897",
    "video:preview": "open scripts/video/promo.html"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^4.20251111.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "puppeteer": "^25.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.90.0"
  }
}
